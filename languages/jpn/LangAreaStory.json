[
  {
    "id": "la-area_story_chapter_area-a01-001",
    "text": "両想いトレーニング"
  },
  {
    "id": "la-area_story_chapter_area-a01-002",
    "text": "運命のタッグ"
  },
  {
    "id": "la-area_story_chapter_area-a01-003",
    "text": "只今、潜入調査中"
  },
  {
    "id": "la-area_story_chapter_area-a01-004",
    "text": "どこ？　スマホ！"
  },
  {
    "id": "la-area_story_chapter_area-a01-005",
    "text": "お散歩&ご飯でリフレッシュ♪"
  },
  {
    "id": "la-area_story_chapter_area-a01-006",
    "text": "重なり合う翼"
  },
  {
    "id": "la-area_story_chapter_area-a01-007",
    "text": "仕返しの行方"
  },
  {
    "id": "la-area_story_chapter_area-a01-008",
    "text": "ちょべりばフリースタイル！"
  },
  {
    "id": "la-area_story_chapter_area-a01-009",
    "text": "眼差しの先へ"
  },
  {
    "id": "la-area_story_chapter_area-a01-010",
    "text": "格別な一杯"
  },
  {
    "id": "la-area_story_chapter_area-a01-011",
    "text": "暗闇の宴、火花散らすチェイス"
  },
  {
    "id": "la-area_story_chapter_area-a02-001",
    "text": "修行！　メガサーキット！"
  },
  {
    "id": "la-area_story_chapter_area-a02-002",
    "text": "緊張をほぐすには……"
  },
  {
    "id": "la-area_story_chapter_area-a02-003",
    "text": "開拓、メガスフィア！"
  },
  {
    "id": "la-area_story_chapter_area-a02-004",
    "text": "エンジョイカードバトル！"
  },
  {
    "id": "la-area_story_chapter_area-a02-005",
    "text": "持ってる？　持ってない？"
  },
  {
    "id": "la-area_story_chapter_area-a02-006",
    "text": "気軽にダンシング♪"
  }
]
