[
  {
    "id": "la-chr-00001_shogi-lines-captured",
    "text": "하지마~!"
  },
  {
    "id": "la-chr-00001_shogi-lines-check",
    "text": "에헤헤~ 몰아붙였다♪"
  },
  {
    "id": "la-chr-00001_shogi-lines-checkmate",
    "text": "와아~ 당했다~…"
  },
  {
    "id": "la-chr-00001_shogi-lines-pon",
    "text": "에잇, 여기다~!"
  },
  {
    "id": "la-chr-00001_shogi-lines-self-turn",
    "text": "간다~"
  },
  {
    "id": "la-chr-00001_shogi-lines-thinking",
    "text": "으~음, 상대가 이렇게 움직이면…"
  },
  {
    "id": "la-chr-00002_shogi-lines-captured",
    "text": "내 동료를 데려가면 안 돼~!"
  },
  {
    "id": "la-chr-00002_shogi-lines-check",
    "text": "나한테서 도망칠 수 없을걸~♪"
  },
  {
    "id": "la-chr-00002_shogi-lines-checkmate",
    "text": "잠깐 기다려! 일단 스톱!"
  },
  {
    "id": "la-chr-00002_shogi-lines-pon",
    "text": "여기로 움직여야~지♪"
  },
  {
    "id": "la-chr-00002_shogi-lines-self-turn",
    "text": "좋았어~"
  },
  {
    "id": "la-chr-00002_shogi-lines-thinking",
    "text": "이쪽? 저쪽? 으으, 모르겠어~"
  },
  {
    "id": "la-chr-00004_shogi-lines-captured",
    "text": "앗~?! 당했다~…"
  },
  {
    "id": "la-chr-00004_shogi-lines-check",
    "text": "어라~? 혹시 아키로제가 이겼나?"
  },
  {
    "id": "la-chr-00004_shogi-lines-checkmate",
    "text": "흠… 제법이네~"
  },
  {
    "id": "la-chr-00004_shogi-lines-pon",
    "text": "여기로 해야~지♪"
  },
  {
    "id": "la-chr-00004_shogi-lines-self-turn",
    "text": "신나게 가보자!"
  },
  {
    "id": "la-chr-00004_shogi-lines-thinking",
    "text": "으~음… 어쩌면 좋지~?"
  },
  {
    "id": "la-chr-00005_shogi-lines-captured",
    "text": "짜마~?!!"
  },
  {
    "id": "la-chr-00005_shogi-lines-check",
    "text": "짠! 하짜마 리치!!"
  },
  {
    "id": "la-chr-00005_shogi-lines-checkmate",
    "text": "거기?! 진짜냐~…"
  },
  {
    "id": "la-chr-00005_shogi-lines-pon",
    "text": "하짜마에게 망설임은 없다!"
  },
  {
    "id": "la-chr-00005_shogi-lines-self-turn",
    "text": "화이팅!"
  },
  {
    "id": "la-chr-00005_shogi-lines-thinking",
    "text": "하짜마 씽킹 타임!"
  },
  {
    "id": "la-chr-00006_shogi-lines-captured",
    "text": "아니~?! 진짜냐~?!"
  },
  {
    "id": "la-chr-00006_shogi-lines-check",
    "text": "후후훗, 시라카미한테서 도망칠 수 없다!"
  },
  {
    "id": "la-chr-00006_shogi-lines-checkmate",
    "text": "흐음흐음, 제법이네요~…"
  },
  {
    "id": "la-chr-00006_shogi-lines-pon",
    "text": "음~ 역시 여기려나~"
  },
  {
    "id": "la-chr-00006_shogi-lines-self-turn",
    "text": "콘콘~♪"
  },
  {
    "id": "la-chr-00006_shogi-lines-thinking",
    "text": "으으음, 이건 고민되네~…"
  },
  {
    "id": "la-chr-00007_shogi-lines-captured",
    "text": "잠깐! 뭐 하는 거야~!"
  },
  {
    "id": "la-chr-00007_shogi-lines-check",
    "text": "후후훗♪ 몰아붙였다♡"
  },
  {
    "id": "la-chr-00007_shogi-lines-checkmate",
    "text": "으아~ 거길 공략하면 힘든데~"
  },
  {
    "id": "la-chr-00007_shogi-lines-pon",
    "text": "일단 이 주변에~♪"
  },
  {
    "id": "la-chr-00007_shogi-lines-self-turn",
    "text": "자, 해보자~"
  },
  {
    "id": "la-chr-00007_shogi-lines-thinking",
    "text": "으으음, 어떻게 할까"
  },
  {
    "id": "la-chr-00010_shogi-lines-captured",
    "text": "에엥~ 어째서~?!"
  },
  {
    "id": "la-chr-00010_shogi-lines-check",
    "text": "어라? 이건 짐이 몰아붙인 건가…?"
  },
  {
    "id": "la-chr-00010_shogi-lines-checkmate",
    "text": "흠… 어라? 짐, 위험한가?"
  },
  {
    "id": "la-chr-00010_shogi-lines-pon",
    "text": "에엥~… 그럼 여기!"
  },
  {
    "id": "la-chr-00010_shogi-lines-self-turn",
    "text": "좋았어~ 간다~♪"
  },
  {
    "id": "la-chr-00010_shogi-lines-thinking",
    "text": "에엥~ 어쩌면 좋을지 모르겠어~"
  },
  {
    "id": "la-chr-00011_shogi-lines-captured",
    "text": "잠깐, 잠깐! 앗?!"
  },
  {
    "id": "la-chr-00011_shogi-lines-check",
    "text": "후훗, 놓치지 않을 거야~♡"
  },
  {
    "id": "la-chr-00011_shogi-lines-checkmate",
    "text": "에엥~ 조금은 봐주면서 하라고~"
  },
  {
    "id": "la-chr-00011_shogi-lines-pon",
    "text": "음~ 여기~?"
  },
  {
    "id": "la-chr-00011_shogi-lines-self-turn",
    "text": "힘내자~!"
  },
  {
    "id": "la-chr-00011_shogi-lines-thinking",
    "text": "여길 이렇게 해서~… 으~음…"
  },
  {
    "id": "la-chr-00012_shogi-lines-captured",
    "text": "흐아아아아아?!!"
  },
  {
    "id": "la-chr-00012_shogi-lines-check",
    "text": "왔구나, 왔어! 놓치지 않겠어!!!"
  },
  {
    "id": "la-chr-00012_shogi-lines-checkmate",
    "text": "우와~~ 그런 수가 있었구나~~!"
  },
  {
    "id": "la-chr-00012_shogi-lines-pon",
    "text": "정했다! 여기다~!"
  },
  {
    "id": "la-chr-00012_shogi-lines-self-turn",
    "text": "좋았어, 간다~♪"
  },
  {
    "id": "la-chr-00012_shogi-lines-thinking",
    "text": "어떡해! 모르겠어~~~!!"
  },
  {
    "id": "la-chr-00013_shogi-lines-captured",
    "text": "으아아~ 당했다~"
  },
  {
    "id": "la-chr-00013_shogi-lines-check",
    "text": "후훗, 이건 게스 직전인가?"
  },
  {
    "id": "la-chr-00013_shogi-lines-checkmate",
    "text": "그렇군, 거기구나~…"
  },
  {
    "id": "la-chr-00013_shogi-lines-pon",
    "text": "후훗, 여기려나~♪"
  },
  {
    "id": "la-chr-00013_shogi-lines-self-turn",
    "text": "잘 부탁해!"
  },
  {
    "id": "la-chr-00013_shogi-lines-thinking",
    "text": "어디 보자, 여긴~…"
  },
  {
    "id": "la-chr-00014_shogi-lines-captured",
    "text": "야, 정말 이럴래~!"
  },
  {
    "id": "la-chr-00014_shogi-lines-check",
    "text": "에잇! 몰아붙였다~♪"
  },
  {
    "id": "la-chr-00014_shogi-lines-checkmate",
    "text": "아~ 그걸 당하면 곤란한데~"
  },
  {
    "id": "la-chr-00014_shogi-lines-pon",
    "text": "음~ 일단 여기로 할까~♪"
  },
  {
    "id": "la-chr-00014_shogi-lines-self-turn",
    "text": "좋았어, 가볼까~"
  },
  {
    "id": "la-chr-00014_shogi-lines-thinking",
    "text": "이건 또 어떻게 하면 좋을까~"
  },
  {
    "id": "la-chr-00015_shogi-lines-captured",
    "text": "웃기지 마~?!"
  },
  {
    "id": "la-chr-00015_shogi-lines-check",
    "text": "미코가 이겼어! 몰아붙였다녜~♪"
  },
  {
    "id": "la-chr-00015_shogi-lines-checkmate",
    "text": "…흐~음, 제법 하네"
  },
  {
    "id": "la-chr-00015_shogi-lines-pon",
    "text": "으~ 이얍!"
  },
  {
    "id": "la-chr-00015_shogi-lines-self-turn",
    "text": "미코, 힘낼게!"
  },
  {
    "id": "la-chr-00015_shogi-lines-thinking",
    "text": "그렇구나… 생각해봐도 잘 모르겠어!"
  },
  {
    "id": "la-chr-00016_shogi-lines-captured",
    "text": "안 돼~?!"
  },
  {
    "id": "la-chr-00016_shogi-lines-check",
    "text": "빨리 도망치지 않으면 잡아버릴 거다~?"
  },
  {
    "id": "la-chr-00016_shogi-lines-checkmate",
    "text": "으으~ 괴롭히지 마~"
  },
  {
    "id": "la-chr-00016_shogi-lines-pon",
    "text": "으~음… 여긴가~?"
  },
  {
    "id": "la-chr-00016_shogi-lines-self-turn",
    "text": "간다~"
  },
  {
    "id": "la-chr-00016_shogi-lines-thinking",
    "text": "아~ 어려워~! 어쩌지~~~"
  },
  {
    "id": "la-chr-00017_shogi-lines-captured",
    "text": "꺄아아악?!"
  },
  {
    "id": "la-chr-00017_shogi-lines-check",
    "text": "위기에 빠졌네~? 지금 기분이 어때~?"
  },
  {
    "id": "la-chr-00017_shogi-lines-checkmate",
    "text": "흐으~음… 글~쿠~나"
  },
  {
    "id": "la-chr-00017_shogi-lines-pon",
    "text": "이쪽이 아니라 여기! 아햐햐♪"
  },
  {
    "id": "la-chr-00017_shogi-lines-self-turn",
    "text": "맡겨줘~♪"
  },
  {
    "id": "la-chr-00017_shogi-lines-thinking",
    "text": "으음… 머릿속이 마구 꼬인 전선 같아"
  },
  {
    "id": "la-chr-00018_shogi-lines-captured",
    "text": "우와, 진짜냐?!"
  },
  {
    "id": "la-chr-00018_shogi-lines-check",
    "text": "어라? 이건 호시마치가 이긴 건가? 그런가☆"
  },
  {
    "id": "la-chr-00018_shogi-lines-checkmate",
    "text": "잘하네! 자 그럼~ 어떻게 할까…"
  },
  {
    "id": "la-chr-00018_shogi-lines-pon",
    "text": "일단… 여기!"
  },
  {
    "id": "la-chr-00018_shogi-lines-self-turn",
    "text": "해볼까요"
  },
  {
    "id": "la-chr-00018_shogi-lines-thinking",
    "text": "음~ 다음엔 어떻게 할까~"
  },
  {
    "id": "la-chr-00019_shogi-lines-captured",
    "text": "이 자식, 웃기지 마~!"
  },
  {
    "id": "la-chr-00019_shogi-lines-check",
    "text": "이얍! 몰아붙였다!!"
  },
  {
    "id": "la-chr-00019_shogi-lines-checkmate",
    "text": "큭… 제법 하네 페코…"
  },
  {
    "id": "la-chr-00019_shogi-lines-pon",
    "text": "이얍, 여기다~!"
  },
  {
    "id": "la-chr-00019_shogi-lines-self-turn",
    "text": "해주겠어 페코"
  },
  {
    "id": "la-chr-00019_shogi-lines-thinking",
    "text": "우와아~ 이거 고민되네 페코~"
  },
  {
    "id": "la-chr-00021_shogi-lines-captured",
    "text": "으아앗~ 진짜냐~"
  },
  {
    "id": "la-chr-00021_shogi-lines-check",
    "text": "몰, 아, 붙, 였, 다♪"
  },
  {
    "id": "la-chr-00021_shogi-lines-checkmate",
    "text": "그렇지~ 그렇게 나올 것 같았어~…"
  },
  {
    "id": "la-chr-00021_shogi-lines-pon",
    "text": "일단 여기로 하자~!"
  },
  {
    "id": "la-chr-00021_shogi-lines-self-turn",
    "text": "좋았어, 힘내자!"
  },
  {
    "id": "la-chr-00021_shogi-lines-thinking",
    "text": "음~ 최선의 수는 뭘까…?"
  },
  {
    "id": "la-chr-00022_shogi-lines-captured",
    "text": "안 돼~ 당했다~…!"
  },
  {
    "id": "la-chr-00022_shogi-lines-check",
    "text": "에~잇! 몰아붙였다~!"
  },
  {
    "id": "la-chr-00022_shogi-lines-checkmate",
    "text": "우와아~ 그렇게 나오시겠다~?"
  },
  {
    "id": "la-chr-00022_shogi-lines-pon",
    "text": "아마… 여기!"
  },
  {
    "id": "la-chr-00022_shogi-lines-self-turn",
    "text": "해보자~!"
  },
  {
    "id": "la-chr-00022_shogi-lines-thinking",
    "text": "우와아~ 어렵네~…!"
  },
  {
    "id": "la-chr-00023_shogi-lines-captured",
    "text": "앗, 잠깐, 진짜냐?!"
  },
  {
    "id": "la-chr-00023_shogi-lines-check",
    "text": "놓치지 않겠어… 마린한테서 못 벗어나"
  },
  {
    "id": "la-chr-00023_shogi-lines-checkmate",
    "text": "흐, 흐음~ 그런 수를 쓰는구나…"
  },
  {
    "id": "la-chr-00023_shogi-lines-pon",
    "text": "어어~ 여긴가~?"
  },
  {
    "id": "la-chr-00023_shogi-lines-self-turn",
    "text": "선장의 본실력을 보여줄게요♪"
  },
  {
    "id": "la-chr-00023_shogi-lines-thinking",
    "text": "으음, 여기가 이렇게 돼서~…"
  },
  {
    "id": "la-chr-00026_shogi-lines-captured",
    "text": "안 돼, 하지 마~?!"
  },
  {
    "id": "la-chr-00026_shogi-lines-check",
    "text": "오? 와타메, 이길 것 같은데? 오? 오?"
  },
  {
    "id": "la-chr-00026_shogi-lines-checkmate",
    "text": "으으음, 이거 참 난감하네…"
  },
  {
    "id": "la-chr-00026_shogi-lines-pon",
    "text": "여기로 정했다~~~!"
  },
  {
    "id": "la-chr-00026_shogi-lines-self-turn",
    "text": "힘내자, 와~!"
  },
  {
    "id": "la-chr-00026_shogi-lines-thinking",
    "text": "으음, 이거 고민되네…"
  },
  {
    "id": "la-chr-00027_shogi-lines-captured",
    "text": "뭐 하는 거야~!"
  },
  {
    "id": "la-chr-00027_shogi-lines-check",
    "text": "더 이상! 도망칠 수 없을걸~♪"
  },
  {
    "id": "la-chr-00027_shogi-lines-checkmate",
    "text": "진짜?! 우와아, 당했다~…"
  },
  {
    "id": "la-chr-00027_shogi-lines-pon",
    "text": "여기로 하는 수밖에~!"
  },
  {
    "id": "la-chr-00027_shogi-lines-self-turn",
    "text": "집중해서 가자"
  },
  {
    "id": "la-chr-00027_shogi-lines-thinking",
    "text": "음~~~ 저길 그렇게 해서~…"
  },
  {
    "id": "la-chr-00028_shogi-lines-captured",
    "text": "너! 웃기지 마~!"
  },
  {
    "id": "la-chr-00028_shogi-lines-check",
    "text": "응나~! 응나땅에게 무릎 꿇는 것이노라~!"
  },
  {
    "id": "la-chr-00028_shogi-lines-checkmate",
    "text": "방금 그건 취소야! 다시 해!"
  },
  {
    "id": "la-chr-00028_shogi-lines-pon",
    "text": "여기로 하겠노라~♪"
  },
  {
    "id": "la-chr-00028_shogi-lines-self-turn",
    "text": "힘내겠노라~!"
  },
  {
    "id": "la-chr-00028_shogi-lines-thinking",
    "text": "음~ 이거 참 고민되노라~"
  },
  {
    "id": "la-chr-00030_shogi-lines-captured",
    "text": "안 돼~?! 하지 마~!"
  },
  {
    "id": "la-chr-00030_shogi-lines-check",
    "text": "자! 몰아붙였다! 자, 자!"
  },
  {
    "id": "la-chr-00030_shogi-lines-checkmate",
    "text": "거기?! 조금은 봐주면서 해~"
  },
  {
    "id": "la-chr-00030_shogi-lines-pon",
    "text": "여기, 여기, 여기~!"
  },
  {
    "id": "la-chr-00030_shogi-lines-self-turn",
    "text": "라미가 해내겠어~!"
  },
  {
    "id": "la-chr-00030_shogi-lines-thinking",
    "text": "으~음… 머릿속이 혼란스러워~?!"
  },
  {
    "id": "la-chr-00031_shogi-lines-captured",
    "text": "에엥?! 그럴 수가~!"
  },
  {
    "id": "la-chr-00031_shogi-lines-check",
    "text": "이야압~! 놓치지 않는다~~~!!"
  },
  {
    "id": "la-chr-00031_shogi-lines-checkmate",
    "text": "호호~ 그렇게 나오시겠다~"
  },
  {
    "id": "la-chr-00031_shogi-lines-pon",
    "text": "여기다~! 이야압~~~!"
  },
  {
    "id": "la-chr-00031_shogi-lines-self-turn",
    "text": "좋았어, 힘내자~!"
  },
  {
    "id": "la-chr-00031_shogi-lines-thinking",
    "text": "뭘 움직일까~♪"
  },
  {
    "id": "la-chr-00032_shogi-lines-captured",
    "text": "우와, 진짜냐"
  },
  {
    "id": "la-chr-00032_shogi-lines-check",
    "text": "호잇☆ 이대로라면 지고 말 텐데~?"
  },
  {
    "id": "la-chr-00032_shogi-lines-checkmate",
    "text": "아~ 역시 거기구나~…"
  },
  {
    "id": "la-chr-00032_shogi-lines-pon",
    "text": "뭐, 움직인다면 여기겠지~"
  },
  {
    "id": "la-chr-00032_shogi-lines-self-turn",
    "text": "해볼까요!"
  },
  {
    "id": "la-chr-00032_shogi-lines-thinking",
    "text": "이러면 저쪽은 이렇게 나올 테니…"
  },
  {
    "id": "la-chr-00034_shogi-lines-captured",
    "text": "으아아아아…?!!"
  },
  {
    "id": "la-chr-00034_shogi-lines-check",
    "text": "자! 이제 승리는 내 겁니다~!"
  },
  {
    "id": "la-chr-00034_shogi-lines-checkmate",
    "text": "아차~ 그거 교묘하네~…"
  },
  {
    "id": "la-chr-00034_shogi-lines-pon",
    "text": "뭐, 일단 여기 아닐까?"
  },
  {
    "id": "la-chr-00034_shogi-lines-self-turn",
    "text": "열심히 해볼까요"
  },
  {
    "id": "la-chr-00034_shogi-lines-thinking",
    "text": "여길 이렇게 하면! …되려나?"
  },
  {
    "id": "la-chr-00035_shogi-lines-captured",
    "text": "앗, 잠깐, 어째서~?!"
  },
  {
    "id": "la-chr-00035_shogi-lines-check",
    "text": "와~아, 완전히 몰렸네~!"
  },
  {
    "id": "la-chr-00035_shogi-lines-checkmate",
    "text": "뭐어~? 그게 말이 돼~?"
  },
  {
    "id": "la-chr-00035_shogi-lines-pon",
    "text": "괄목하라! 이 몸의 한 수를!"
  },
  {
    "id": "la-chr-00035_shogi-lines-self-turn",
    "text": "진짜 실력을 보여줄게"
  },
  {
    "id": "la-chr-00035_shogi-lines-thinking",
    "text": "음~… 대충 해도 되겠지 뭐"
  },
  {
    "id": "la-chr-00036_shogi-lines-captured",
    "text": "잠깐, 안 돼애애애?!!"
  },
  {
    "id": "la-chr-00036_shogi-lines-check",
    "text": "이제 못 도망쳐요~"
  },
  {
    "id": "la-chr-00036_shogi-lines-checkmate",
    "text": "저기, 이건 위험…한가?"
  },
  {
    "id": "la-chr-00036_shogi-lines-pon",
    "text": "일단 여기로 할까"
  },
  {
    "id": "la-chr-00036_shogi-lines-self-turn",
    "text": "멋진 모습을 보여줘볼까~"
  },
  {
    "id": "la-chr-00036_shogi-lines-thinking",
    "text": "자, 어떻게 할까~"
  },
  {
    "id": "la-chr-00037_shogi-lines-captured",
    "text": "꺄아아악, 잠깐 기다려?!"
  },
  {
    "id": "la-chr-00037_shogi-lines-check",
    "text": "어라~? 코요가 이기겠는데~?"
  },
  {
    "id": "la-chr-00037_shogi-lines-checkmate",
    "text": "아~ 그래, 그런 수가 있었구나~"
  },
  {
    "id": "la-chr-00037_shogi-lines-pon",
    "text": "코요의 수를 읽을 수 있을까~♪"
  },
  {
    "id": "la-chr-00037_shogi-lines-self-turn",
    "text": "준비 다 됐어~!"
  },
  {
    "id": "la-chr-00037_shogi-lines-thinking",
    "text": "그래, 그래, 그래… 감 잡았다!"
  },
  {
    "id": "la-chr-00039_shogi-lines-captured",
    "text": "에엥~?! 당했다~!"
  },
  {
    "id": "la-chr-00039_shogi-lines-check",
    "text": "신난다! 승리가 코앞이다 고자루♪"
  },
  {
    "id": "la-chr-00039_shogi-lines-checkmate",
    "text": "이거 참 교묘하네 고자루…"
  },
  {
    "id": "la-chr-00039_shogi-lines-pon",
    "text": "여, 여기?! 핫핫핫…"
  },
  {
    "id": "la-chr-00039_shogi-lines-self-turn",
    "text": "가자고자루~!"
  },
  {
    "id": "la-chr-00039_shogi-lines-thinking",
    "text": "이, 이러면 그렇게 돼서…!"
  },
  {
    "id": "la-chr-03001_shogi-lines-captured",
    "text": "에엥~?! 웃기지 마~!"
  },
  {
    "id": "la-chr-03001_shogi-lines-check",
    "text": "어라라~? 몰려버렸네~?"
  },
  {
    "id": "la-chr-03001_shogi-lines-checkmate",
    "text": "에엥~ 그렇게 한다고~?"
  },
  {
    "id": "la-chr-03001_shogi-lines-pon",
    "text": "어어~ 여긴가~?"
  },
  {
    "id": "la-chr-03001_shogi-lines-self-turn",
    "text": "언제든 오케이야~!"
  },
  {
    "id": "la-chr-03001_shogi-lines-thinking",
    "text": "이히힛, 어떻게 할까~♪"
  },
  {
    "id": "la-chr-03002_shogi-lines-captured",
    "text": "으아아~… 진짜냐~…"
  },
  {
    "id": "la-chr-03002_shogi-lines-check",
    "text": "오~예, 놓치지 않는다~!"
  },
  {
    "id": "la-chr-03002_shogi-lines-checkmate",
    "text": "아, 거, 거기로 할 거야? …정말로?"
  },
  {
    "id": "la-chr-03002_shogi-lines-pon",
    "text": "여기! 어때?!"
  },
  {
    "id": "la-chr-03002_shogi-lines-self-turn",
    "text": "신나게 가자~"
  },
  {
    "id": "la-chr-03002_shogi-lines-thinking",
    "text": "…흠? 어쩌면 좋지?"
  },
  {
    "id": "la-chr-03003_shogi-lines-captured",
    "text": "에엥~?! 왜왜왜~?!"
  },
  {
    "id": "la-chr-03003_shogi-lines-check",
    "text": "이건 보나마나 요피의 승리네!"
  },
  {
    "id": "la-chr-03003_shogi-lines-checkmate",
    "text": "뭐어?! 거긴 안 돼~!"
  },
  {
    "id": "la-chr-03003_shogi-lines-pon",
    "text": "좋~았어, 여기다~~~!"
  },
  {
    "id": "la-chr-03003_shogi-lines-self-turn",
    "text": "해보자~~~!!"
  },
  {
    "id": "la-chr-03003_shogi-lines-thinking",
    "text": "으~음… 모르겠네~"
  },
  {
    "id": "la-chr-03004_shogi-lines-captured",
    "text": "노?! 하지 마~!"
  },
  {
    "id": "la-chr-03004_shogi-lines-check",
    "text": "이봐 이봐, 어떻게 할 거야~?"
  },
  {
    "id": "la-chr-03004_shogi-lines-checkmate",
    "text": "크으~ 만만치 않네~…!"
  },
  {
    "id": "la-chr-03004_shogi-lines-pon",
    "text": "여긴가~? 호잇♪"
  },
  {
    "id": "la-chr-03004_shogi-lines-self-turn",
    "text": "가봅시다~!"
  },
  {
    "id": "la-chr-03004_shogi-lines-thinking",
    "text": "그래그래… 그 수로 하자~♪"
  },
  {
    "id": "la-chr-03005_shogi-lines-captured",
    "text": "으아아~ 당했다…"
  },
  {
    "id": "la-chr-03005_shogi-lines-check",
    "text": "아직 도망칠 수 있다…고 생각하지?"
  },
  {
    "id": "la-chr-03005_shogi-lines-checkmate",
    "text": "흐음~ 그렇게 나오시겠다~?"
  },
  {
    "id": "la-chr-03005_shogi-lines-pon",
    "text": "음~ 뭐, 일단 여기로"
  },
  {
    "id": "la-chr-03005_shogi-lines-self-turn",
    "text": "맡겨주세요~!"
  },
  {
    "id": "la-chr-03005_shogi-lines-thinking",
    "text": "아… 잠깐. 생각 좀 해볼게"
  },
  {
    "id": "la-chr-03006_shogi-lines-captured",
    "text": "잠깐! 아앗, 정말~!"
  },
  {
    "id": "la-chr-03006_shogi-lines-check",
    "text": "어떻게 된 걸까~? 완전히 몰렸네~"
  },
  {
    "id": "la-chr-03006_shogi-lines-checkmate",
    "text": "앗! 그 수에는 약한데~…"
  },
  {
    "id": "la-chr-03006_shogi-lines-pon",
    "text": "음~… 여기!!"
  },
  {
    "id": "la-chr-03006_shogi-lines-self-turn",
    "text": "우아하게 갈게요♪"
  },
  {
    "id": "la-chr-03006_shogi-lines-thinking",
    "text": "음~ 이럴 때는 과감하게~! 가보자!"
  },
  {
    "id": "la-chr-03007_shogi-lines-captured",
    "text": "잠깐 기다려, 어째서~?!"
  },
  {
    "id": "la-chr-03007_shogi-lines-check",
    "text": "아하하, 완전히 몰렸네. 바~보♡"
  },
  {
    "id": "la-chr-03007_shogi-lines-checkmate",
    "text": "으음~ 그건 안 돼. 다시 해"
  },
  {
    "id": "la-chr-03007_shogi-lines-pon",
    "text": "몰라~~~ 여기로 할래!"
  },
  {
    "id": "la-chr-03007_shogi-lines-self-turn",
    "text": "진짜 실력을 발휘하겠어♪"
  },
  {
    "id": "la-chr-03007_shogi-lines-thinking",
    "text": "으~음, 으~음, 모르겠어~?!"
  },
  {
    "id": "la-chr-03008_shogi-lines-captured",
    "text": "아…"
  },
  {
    "id": "la-chr-03008_shogi-lines-check",
    "text": "이걸로 몰아붙였어"
  },
  {
    "id": "la-chr-03008_shogi-lines-checkmate",
    "text": "굿굿! 잘하는데~"
  },
  {
    "id": "la-chr-03008_shogi-lines-pon",
    "text": "여긴가"
  },
  {
    "id": "la-chr-03008_shogi-lines-self-turn",
    "text": "자, 가볼까"
  },
  {
    "id": "la-chr-03008_shogi-lines-thinking",
    "text": "…이거 참 고민되네"
  },
  {
    "id": "la-chr-03009_shogi-lines-captured",
    "text": "앗?! 어째서~?!"
  },
  {
    "id": "la-chr-03009_shogi-lines-check",
    "text": "이제 코보의 승리야! 오예오예!"
  },
  {
    "id": "la-chr-03009_shogi-lines-checkmate",
    "text": "앗! 왜 거기인 거야~?!"
  },
  {
    "id": "la-chr-03009_shogi-lines-pon",
    "text": "아~~~ 여기~~~!!"
  },
  {
    "id": "la-chr-03009_shogi-lines-self-turn",
    "text": "간다~"
  },
  {
    "id": "la-chr-03009_shogi-lines-thinking",
    "text": "…으으으으으으으으음~!!"
  },
  {
    "id": "la-chr-04001_shogi-lines-captured",
    "text": "What's?! Why?! Why?!"
  },
  {
    "id": "la-chr-04001_shogi-lines-check",
    "text": "오~예! 사신이 승리를 뺏으러 왔다!"
  },
  {
    "id": "la-chr-04001_shogi-lines-checkmate",
    "text": "으앗! 노노, 거긴 안 돼~"
  },
  {
    "id": "la-chr-04001_shogi-lines-pon",
    "text": "여기야! 분명 여기야!"
  },
  {
    "id": "la-chr-04001_shogi-lines-self-turn",
    "text": "기대해도 좋아"
  },
  {
    "id": "la-chr-04001_shogi-lines-thinking",
    "text": "으~~~ 아~~~…"
  },
  {
    "id": "la-chr-04002_shogi-lines-captured",
    "text": "에엥~?! 어째서~…"
  },
  {
    "id": "la-chr-04002_shogi-lines-check",
    "text": "어라어라~? 몰아붙였네~♪"
  },
  {
    "id": "la-chr-04002_shogi-lines-checkmate",
    "text": "에엥~ 그러지 마~"
  },
  {
    "id": "la-chr-04002_shogi-lines-pon",
    "text": "역시 움직인다면 여기려나~"
  },
  {
    "id": "la-chr-04002_shogi-lines-self-turn",
    "text": "간다, 간다~!"
  },
  {
    "id": "la-chr-04002_shogi-lines-thinking",
    "text": "음~… 자, 어떻게 할까?"
  },
  {
    "id": "la-chr-04003_shogi-lines-captured",
    "text": "WAH~?! 어째서~?!"
  },
  {
    "id": "la-chr-04003_shogi-lines-check",
    "text": "크크크, 몰아붙였다♪"
  },
  {
    "id": "la-chr-04003_shogi-lines-checkmate",
    "text": "WAH~ 거긴 안 돼~…"
  },
  {
    "id": "la-chr-04003_shogi-lines-pon",
    "text": "여기로 할까~"
  },
  {
    "id": "la-chr-04003_shogi-lines-self-turn",
    "text": "열심히 해봐요!"
  },
  {
    "id": "la-chr-04003_shogi-lines-thinking",
    "text": "으~음, 여기가 좋을까~?"
  },
  {
    "id": "la-chr-04007_shogi-lines-captured",
    "text": "어째서야~! 정말~~~!"
  },
  {
    "id": "la-chr-04007_shogi-lines-check",
    "text": "진짜야?! 몰아붙였잖아~♪"
  },
  {
    "id": "la-chr-04007_shogi-lines-checkmate",
    "text": "으앗, 보통 거길 공략하나~?!"
  },
  {
    "id": "la-chr-04007_shogi-lines-pon",
    "text": "음~ 아마 여긴가~?"
  },
  {
    "id": "la-chr-04007_shogi-lines-self-turn",
    "text": "실력을 보여줄 때야!"
  },
  {
    "id": "la-chr-04007_shogi-lines-thinking",
    "text": "에엥~ 고민되는데~…"
  },
  {
    "id": "la-chr-04010_shogi-lines-captured",
    "text": "잠깐?! 에엥~…?"
  },
  {
    "id": "la-chr-04010_shogi-lines-check",
    "text": "후훗, 나한테서 도망칠 수 없어♪"
  },
  {
    "id": "la-chr-04010_shogi-lines-checkmate",
    "text": "비, 비겁해! 그런 짓을 하다니"
  },
  {
    "id": "la-chr-04010_shogi-lines-pon",
    "text": "정했다! 여기로 할래!"
  },
  {
    "id": "la-chr-04010_shogi-lines-self-turn",
    "text": "자, 해볼게"
  },
  {
    "id": "la-chr-04010_shogi-lines-thinking",
    "text": "이, 이렇게… 아니, 이렇게? 으, 음~…"
  },
  {
    "id": "la-chr-04012_shogi-lines-captured",
    "text": "뭐어어어~?! 말도 안 돼…"
  },
  {
    "id": "la-chr-04012_shogi-lines-check",
    "text": "하~하하핫! 내가 이긴 것 같네!"
  },
  {
    "id": "la-chr-04012_shogi-lines-checkmate",
    "text": "흐, 흐~음… 제법 하네"
  },
  {
    "id": "la-chr-04012_shogi-lines-pon",
    "text": "에~잇, 여기!"
  },
  {
    "id": "la-chr-04012_shogi-lines-self-turn",
    "text": "멋진 모습을 보여주겠어~!"
  },
  {
    "id": "la-chr-04012_shogi-lines-thinking",
    "text": "으으음… 이거 꽤 고민되네…"
  },
  {
    "id": "la-chr-04013_shogi-lines-captured",
    "text": "응?! 잠깐…"
  },
  {
    "id": "la-chr-04013_shogi-lines-check",
    "text": "후훗, 도망칠 수 있다면 해봐♪"
  },
  {
    "id": "la-chr-04013_shogi-lines-checkmate",
    "text": "그렇구나, 그런 공략법도 있구나…"
  },
  {
    "id": "la-chr-04013_shogi-lines-pon",
    "text": "이 상황이라면… 여길까?"
  },
  {
    "id": "la-chr-04013_shogi-lines-self-turn",
    "text": "최선을 다할게"
  },
  {
    "id": "la-chr-04013_shogi-lines-thinking",
    "text": "음~… 일단 감으로 갈까요♪"
  },
  {
    "id": "la-chr-04014_shogi-lines-captured",
    "text": "아아앗?! 어째서~?!"
  },
  {
    "id": "la-chr-04014_shogi-lines-check",
    "text": "오~예! 비부가 승리를 낚아채겠어!"
  },
  {
    "id": "la-chr-04014_shogi-lines-checkmate",
    "text": "싫어~!! 방금 그건 취소야!!"
  },
  {
    "id": "la-chr-04014_shogi-lines-pon",
    "text": "여기다~! 가라, 가~!"
  },
  {
    "id": "la-chr-04014_shogi-lines-self-turn",
    "text": "레츠 고~♪"
  },
  {
    "id": "la-chr-04014_shogi-lines-thinking",
    "text": "으~~~~~음…"
  },
  {
    "id": "la-chr-04015_shogi-lines-captured",
    "text": "잠깐 기다려… 아아~…"
  },
  {
    "id": "la-chr-04015_shogi-lines-check",
    "text": "후훗, 도망치면 안 돼"
  },
  {
    "id": "la-chr-04015_shogi-lines-checkmate",
    "text": "어머! 당했네…!"
  },
  {
    "id": "la-chr-04015_shogi-lines-pon",
    "text": "여기! 맞으려나…?"
  },
  {
    "id": "la-chr-04015_shogi-lines-self-turn",
    "text": "즐거운 시간 보내자"
  },
  {
    "id": "la-chr-04015_shogi-lines-thinking",
    "text": "고민되네~… 어쩌지?"
  },
  {
    "id": "la-chr-04016_shogi-lines-captured",
    "text": "BAU BAU~?! 어떻게~?!"
  },
  {
    "id": "la-chr-04016_shogi-lines-check",
    "text": "BAU BAU~! 후와와의 승리예요♪"
  },
  {
    "id": "la-chr-04016_shogi-lines-checkmate",
    "text": "BAU BAU?! 짓궂게 굴지 마~!"
  },
  {
    "id": "la-chr-04016_shogi-lines-pon",
    "text": "BAU BAU! 여기로 정했다!"
  },
