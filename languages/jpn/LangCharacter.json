  },
  {
    "id": "la-search_keyword-chr-00014",
    "text": "おおかみ みお"
  },
  {
    "id": "la-search_keyword-chr-00015",
    "text": "さくら みこ"
  },
  {
    "id": "la-search_keyword-chr-00016",
    "text": "ねこまた おかゆ"
  },
  {
    "id": "la-search_keyword-chr-00017",
    "text": "いぬがみ ころね"
  },
  {
    "id": "la-search_keyword-chr-00018",
    "text": "ほしまち すいせい"
  },
  {
    "id": "la-search_keyword-chr-00019",
    "text": "うさだ ぺこら"
  },
  {
    "id": "la-search_keyword-chr-00021",
    "text": "しらぬい ふれあ"
  },
  {
    "id": "la-search_keyword-chr-00022",
    "text": "しろがね のえる"
  },
  {
    "id": "la-search_keyword-chr-00023",
