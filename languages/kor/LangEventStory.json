[
  {
    "id": "la-event_story_chapter-marathon_event-normal-001-chapter-01-1",
    "text": "Where is 여름 바캉스?"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-001-chapter-01-2",
    "text": "여름이다! 바다다! 바캉스다!!"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-001-chapter-01-3",
    "text": "해상 전면전"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-001-chapter-01-4",
    "text": "위험한 모래장난♪"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-001-chapter-01-5",
    "text": "아지마루! 비치 바비큐"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-001-chapter-01-6",
    "text": "여름 바캉스, 석양에 물들어"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-003-chapter-01-1",
    "text": "드디어 바캉스!"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-003-chapter-01-2",
    "text": "게이머즈 in 무인도"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-003-chapter-01-3",
    "text": "정들면 고향?"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-003-chapter-01-4",
    "text": "제한 시간"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-003-chapter-01-5",
    "text": "정글을 넘어"
  },
  {
    "id": "la-event_story_chapter-marathon_event-normal-003-chapter-01-6",
    "text": "탈출할 수 있을까?!"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-001-chapter-01-01",
    "text": "라이브를 위해 준비 중"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-001-chapter-01-02",
    "text": "세상에서 가장 뜨거운 여름, 개막!"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-001-chapter-02-01",
    "text": "여름 하면 떠오르는 것은?"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-001-chapter-02-02",
    "text": "바다에서 반짝이는 명추리♪"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-001-chapter-03-01",
    "text": "출발! 사랑의 쇼핑♪"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-001-chapter-03-02",
    "text": "당신에게 어울리는 옷은??"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-001-chapter-04-01",
    "text": "공주님은 시원해지고 싶다!"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-001-chapter-04-02",
    "text": "비닐 풀을 준비하라!"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-001-chapter-05-01",
    "text": "기대되는 외출♪"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-001-chapter-05-02",
    "text": "귀여운 오해♪"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-002-chapter-01-01",
    "text": "여름, 만끽하고 있어?"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-002-chapter-01-02",
    "text": "최고의 여름을 보내는 법♪"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-002-chapter-02-01",
    "text": "자극을 찾아서"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-002-chapter-02-02",
    "text": "식지 않는 열"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-002-chapter-03-01",
    "text": "한여름의 게으름 타임"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-002-chapter-03-02",
    "text": "낙원의 결투!"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-002-chapter-04-01",
    "text": "힘차게 나가자!"
  },
  {
    "id": "la-event_story_chapter-marathon_event-relay-002-chapter-04-02",
    "text": "자 최애의 세계로!"
  }
]
