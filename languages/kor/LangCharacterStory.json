[
  {
    "id": "la-character_story-chr-00001-001",
    "text": "버추얼 아이돌의 길"
  },
  {
    "id": "la-character_story-chr-00002-001",
    "text": "귀요미 고성능? 로봇"
  },
  {
    "id": "la-character_story-chr-00004-001",
    "text": "짓궂은 치유계 하프 엘프"
  },
  {
    "id": "la-character_story-chr-00005-001",
    "text": "두근두근☆하짜마 쿠킹"
  },
  {
    "id": "la-character_story-chr-00006-001",
    "text": "파워풀 여우!"
  },
  {
    "id": "la-character_story-chr-00007-001",
    "text": "청초하고 약삭빠른 슈퍼 아이돌☆"
  },
  {
    "id": "la-character_story-chr-00010-001",
    "text": "수줍음 많고 귀여운 유유자적 오니 아가씨"
  },
  {
    "id": "la-character_story-chr-00010-002",
    "text": "여름에 반짝이는 오니의 카와요 미소☆"
  },
  {
    "id": "la-character_story-chr-00011-001",
    "text": "행동파 악마의 소소한 소풍"
  },
  {
    "id": "la-character_story-chr-00012-001",
    "text": "생기발랄 태양 소녀!"
  },
  {
    "id": "la-character_story-chr-00013-001",
    "text": "새로운 풍경을 찾아서"
  },
  {
    "id": "la-character_story-chr-00014-001",
    "text": "자상한 동물 귀의 포용력♪"
  },
  {
    "id": "la-character_story-chr-00015-001",
    "text": "엘리트&엘리~트"
  },
  {
    "id": "la-character_story-chr-00016-001",
    "text": "사랑이 만점♡마성의 고양이의 행복 허그"
  },
  {
    "id": "la-character_story-chr-00017-001",
    "text": "자유분방 도그의 댄스 레슨☆"
  },
  {
    "id": "la-character_story-chr-00018-001",
    "text": "천진난만한 가희"
  },
  {
    "id": "la-character_story-chr-00019-001",
    "text": "허세 토끼의 스크램블 데이"
  },
  {
    "id": "la-character_story-chr-00021-001",
    "text": "세심한 하프 엘프"
  },
  {
    "id": "la-character_story-chr-00022-001",
    "text": "모두에게 힐링을 전하는 머슬♪"
  },
  {
    "id": "la-character_story-chr-00023-001",
    "text": "좋아좋아♡매혹적인 섹시 선장"
  },
  {
    "id": "la-character_story-chr-00026-001",
    "text": "느긋하게 보내는 것도 나쁘지 않지?"
  },
  {
    "id": "la-character_story-chr-00027-001",
    "text": "이게 바로 악마적 소행! 작열 TMT"
  },
  {
    "id": "la-character_story-chr-00028-001",
    "text": "어리광을 잘 부리는 귀요미 프린세스"
  },
  {
    "id": "la-character_story-chr-00028-002",
    "text": "응나아아이♡ 공주님의 서머 풀"
  },
  {
    "id": "la-character_story-chr-00030-001",
    "text": "어리광쟁이 츳코미 영애"
  },
  {
    "id": "la-character_story-chr-00031-001",
    "text": "모두의 마음의 에너지 드링크!"
  },
  {
    "id": "la-character_story-chr-00032-001",
    "text": "늘 든든해♪ 라라이온"
  },
  {
    "id": "la-character_story-chr-00034-001",
    "text": "혼신을 다하는 엔터테이너!!"
  },
  {
    "id": "la-character_story-chr-00035-001",
    "text": "제멋대로 키즈☆이 몸은 총수!"
  },
  {
    "id": "la-character_story-chr-00036-001",
    "text": "믿음직한 간부의 환대"
  },
  {
    "id": "la-character_story-chr-00037-001",
    "text": "두뇌 명석? holoX의 두뇌!"
  },
  {
    "id": "la-character_story-chr-00039-001",
    "text": "최강? 허둥지둥 경호원"
  },
  {
    "id": "la-character_story-chr-03001-001",
    "text": "MALAS! 장난꾸러기 등장"
  },
  {
    "id": "la-character_story-chr-03002-001",
    "text": "조금 수줍고 분방한 달의 여신"
  },
  {
    "id": "la-character_story-chr-03003-001",
    "text": "러블리 에일리언"
  },
  {
    "id": "la-character_story-chr-03004-001",
    "text": "하이텐션 좀비의 모험"
  },
  {
    "id": "la-character_story-chr-03004-002",
    "text": "서머☆ 크레이지 쇼핑!"
  },
  {
    "id": "la-character_story-chr-03005-001",
    "text": "쿨하고 예리한 고대 무기"
  },
  {
    "id": "la-character_story-chr-03006-001",
    "text": "공작 아가씨의 유쾌하고 우아한 하루"
  },
  {
    "id": "la-character_story-chr-03007-001",
    "text": "귀엽고 입이 험한 걸"
  },
  {
    "id": "la-character_story-chr-03008-001",
    "text": "터프하고 쿨한 대장장이의 하루"
  },
  {
    "id": "la-character_story-chr-03009-001",
    "text": "Shine Your Day!"
  },
  {
    "id": "la-character_story-chr-04001-001",
    "text": "짓궂고 다정한 그림 리퍼"
  },
  {
    "id": "la-character_story-chr-04001-002",
    "text": "긴장Death! 사신의 비치 라이브"
  },
  {
    "id": "la-character_story-chr-04002-001",
    "text": "오늘도 씩씩하게, Kikkeriki!"
  },
  {
    "id": "la-character_story-chr-04003-001",
    "text": "샤이 걸의 분투"
  },
  {
    "id": "la-character_story-chr-04003-002",
    "text": "여름의 WAH더풀 데이☆"
  },
  {
    "id": "la-character_story-chr-04007-001",
    "text": "HiRyS! 익살스러운 네피림"
  },
  {
    "id": "la-character_story-chr-04010-001",
    "text": "연예인이 아니다! 완전무결한 시간의 감시자"
  },
  {
    "id": "la-character_story-chr-04012-001",
    "text": "애교 가득 카오스 여행길☆"
  },
  {
    "id": "la-character_story-chr-04013-001",
    "text": "유쾌한 수집가의 독특한 유실물"
  },
  {
    "id": "la-character_story-chr-04014-001",
    "text": "개구쟁이 보석의 반짝반짝 스마일"
  },
  {
    "id": "la-character_story-chr-04015-001",
    "text": "사랑 가득♪ 섹시한 소리의 마인"
  },
  {
    "id": "la-character_story-chr-04016-001",
    "text": "포용력 만점♪ 폭신폭신 도그"
  },
  {
    "id": "la-character_story-chr-04017-001",
    "text": "애교 만점♪ 복슬복슬 도그"
  },
  {
    "id": "la-character_story-chr-06002-001",
    "text": "장난기 많고 귀여운 음악가의 새싹"
  },
  {
    "id": "la-character_story-chr-06003-001",
    "text": "지니어스! 여사장의 한계밥☆"
  },
  {
    "id": "la-character_story-chr-06004-001",
    "text": "전대미문의 진지한 예술 걸"
  },
  {
    "id": "la-character_story-chr-06005-001",
    "text": "등장! ReGLOSS의 반쵸"
  }
]
